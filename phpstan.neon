parameters:
    # Pinned numerically rather than "max": max moves with PHPStan releases, and CI resolves
    # dependencies unpinned, so a new minor would fail an otherwise unrelated commit.
    level: 10
    paths:
        - src
        - tests
    # meyfa/php-svg still declares legacy resource returns, so the runtime GdImage guards
    # in PhpSvgRasterizer are deliberate even though the PHPDoc says they cannot fail.
    treatPhpDocTypesAsCertain: false
