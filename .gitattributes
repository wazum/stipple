/bin/icon-row.php   export-ignore
/bin/generate-gallery.php export-ignore
/examples           export-ignore
/tests              export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpstan.neon       export-ignore
/phpunit.xml        export-ignore
/php-cs-fixer.config.php export-ignore
